<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/elina_bg"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/elina_text"/><TextView android:id="@+id/authStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="18dp" android:textColor="@color/elina_text"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI" android:textStyle="bold" android:textSize="18sp" android:textColor="@color/elina_primary" android:paddingTop="24dp"/><EditText android:id="@+id/apiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Development API key (stored encrypted)" android:inputType="textPassword" android:textColor="@color/elina_text" android:textColorHint="@color/elina_muted"/><Button android:id="@+id/saveKey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save credential"/>
<EditText android:id="@+id/userName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="User name" android:textColor="@color/elina_text" android:textColorHint="@color/elina_muted"/><Spinner android:id="@+id/personality" android:layout_width="match_parent" android:layout_height="wrap_content"/><Spinner android:id="@+id/voice" android:layout_width="match_parent" android:layout_height="wrap_content"/><Spinner android:id="@+id/thinking" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Memory" android:textStyle="bold" android:textSize="18sp" android:textColor="@color/elina_primary" android:paddingTop="24dp"/><Switch android:id="@+id/memoryEnabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Memory enabled" android:textColor="@color/elina_text"/><Button android:id="@+id/openMemory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View memories / delete"/>
<TextView android:id="@+id/avatarInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/elina_text" android:paddingTop="24dp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wake" android:textStyle="bold" android:textSize="18sp" android:textColor="@color/elina_primary" android:paddingTop="24dp"/><EditText android:id="@+id/wakePhrase" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/elina_text"/><Switch android:id="@+id/backgroundWake" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Background wake" android:textColor="@color/elina_text"/><Button android:id="@+id/openAccessibility" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open Accessibility Settings"/><TextView android:id="@+id/capabilities" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/elina_text" android:paddingTop="18dp"/></LinearLayout></ScrollView>
